<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoMessages</AssemblyName>
    <RootNamespace>AutoMessages</RootNamespace>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <ScpSlManagedPath Condition="'$(ScpSlManagedPath)' == '' and '$(ScpSlServerPath)' != ''">$(ScpSlServerPath)\SCPSL_Data\Managed</ScpSlManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ScpSlManagedPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ScpSlManagedPath)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="CommandSystem.Core" HintPath="$(ScpSlManagedPath)\CommandSystem.Core.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ScpSlManagedPath)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateScpSlReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ScpSlManagedPath)' == ''" Text="Set ScpSlManagedPath or ScpSlServerPath to the SCP:SL dedicated server Managed directory." />
    <Error Condition="!Exists('$(ScpSlManagedPath)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found in '$(ScpSlManagedPath)'. Update ScpSlManagedPath." />
    <Error Condition="!Exists('$(ScpSlManagedPath)\Assembly-CSharp-firstpass.dll')" Text="Assembly-CSharp-firstpass.dll was not found in '$(ScpSlManagedPath)'. Update ScpSlManagedPath." />
    <Error Condition="!Exists('$(ScpSlManagedPath)\CommandSystem.Core.dll')" Text="CommandSystem.Core.dll was not found in '$(ScpSlManagedPath)'. Update ScpSlManagedPath." />
    <Error Condition="!Exists('$(ScpSlManagedPath)\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll was not found in '$(ScpSlManagedPath)'. Update ScpSlManagedPath." />
  </Target>
</Project>
